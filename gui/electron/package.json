{
  "name": "genesis-forge",
  "version": "1.0.0",
  "description": "Genesis Forge - 3D Asset Generation from Text and Images",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win --x64",
    "dev": "electron . --dev"
  },
  "author": "Genesis",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.1.3",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "three": "^0.160.1"
  },
  "build": {
    "appId": "com.genesis.forge",
    "productName": "Genesis Forge",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": ["nsis"],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "**/*",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend"
      }
    ]
  }
}
